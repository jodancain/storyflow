# Copy outside the build context; replace with private host paths.
# API key contents belong only in EDITOR_API_KEY_FILE, never in this file.
EDITOR_INPUT_DIR=/absolute/private/editor-input
EDITOR_API_KEY_FILE=/absolute/private/editor-secrets/anthropic-api-key
EDITOR_ROUTE_PROFILE=9router-native
EDITOR_ANTHROPIC_BASE_URL=https://router.yundongyl.cn
EDITOR_MODEL=ezr/claude-opus-5-5
# Explicit legacy profile (change all three together; no automatic fallback):
# EDITOR_ROUTE_PROFILE=ezr-direct
# EDITOR_ANTHROPIC_BASE_URL=https://ezr.sh
# EDITOR_MODEL=claude-opus-5-5
