{
  "name": "storyflow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=24"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.review.config.ts",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:init": "tsx scripts/init.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.4.0",
    "jszip": "3.10.2",
    "playwright": "1.63.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "25.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
