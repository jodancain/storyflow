HOST=127.0.0.1
PORT=18296
# Native development default is outside the checkout. Docker sets /data.
STORYFLOW_DATA_DIR=
PUBLIC_BASE_URL=http://127.0.0.1:18296
# Future deployment: https://storyflow.yundongyl.cn
STORYFLOW_ADMIN_PASSWORD=
SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL=seedance-2-0
# Optional explicit alternate on the same relay; empty preserves Seedance.
# Supported Veo IDs: veo-3.1-generate-001 / veo-3.1-fast-generate-001 / veo-3.1-lite-generate-001.
VIDEO_MODEL=
FAL_KEY=
OPUS_BASE_URL=
OPUS_API_KEY=
OPUS_MODEL=claude-opus-5-5
PYTHON=python3
FFMPEG=ffmpeg
FFPROBE=ffprobe
CHROMIUM_PATH=

# Optional still-image generation (one submission per task, no model fallback).
# Use the OpenAI-compatible base including /v1 where required by your provider.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# Optional: explicitly publish only these project review snapshots (comma-separated IDs).
# All writes still require administrator login. Keep empty for private/local projects.
STORYFLOW_PUBLIC_REVIEW_PROJECTS=
STORYFLOW_PUBLIC_REVIEW_API_BASE=/api
